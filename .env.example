# Copy this file to .env and fill in real values. Never commit .env.

# Salesforce
SF_USERNAME=your-uat-username
SF_PASSWORD=your-uat-password
SF_SECURITY_TOKEN=your-uat-security-token
# Standard sandbox: test | Custom My Domain sandbox: yourorg--uat.sandbox
SF_DOMAIN=symphonyinfra--uat.sandbox

# Gemini (NAIP screen + classify)
GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_SCREEN_MODEL=gemini-3.5-flash-lite
# GEMINI_SCREEN_THINKING_LEVEL=LOW
# GEMINI_THINKING_LEVEL=MEDIUM
# GEMINI_SOLO_CELL_CONF=0.85

# Claude (dual-model cell confirm / rooftop HVAC check)
ANTHROPIC_API_KEY=sk-ant-your-key-here
# CLAUDE_MODELS=claude-sonnet-4-6,claude-haiku-4-5-20251001
# CLAUDE_ESCALATION_MODEL=claude-sonnet-4-6

# Nearmap (high-res vert + obliques; billed against the subscription)
NEARMAP_API_KEY=your-nearmap-key
# NEARMAP_TIERED=1
# BIFURCATED_AI=1
# NEARMAP_OBLIQUE_VIEWS=North,East

# OSM Overpass is used as a cheap prefilter before Nearmap (no API key).
# Set OSM_PREFILTER=0 to skip. Stale NAIP (> NAIP_MAX_AGE_YEARS) does not OSM-skip.

# Classify knobs (E2E leftovers after DB-only unique hits)
# PROXIMITY_AMBIGUITY_GAP_M=60
# PROXIMITY_ADDRESS_AFFINITY_M=100
# ROOFTOP_HOST_OFFSET_M=15
# ASSET_OFFSET_LEEWAY_M=25
# PIN_CLUSTER_M=25
# CHIP_SIZE_M=300
# GEMINI_SOLO_CELL_CONF=0.85
# NEARMAP_EMPTY_LOCK_CONF=0.90

# Azure SQL (FCC / TowerSource proximity). Blank auth = Entra token (`az login`).
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your_db
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
# AZURE_SQL_ODBC_AUTHENTICATION=
# Enrichment KPIs also land in dbo.EnrichmentRun / dbo.EnrichmentSiteOutcome.
# METRICS_SQL=0 skips those upserts (JSONL ledger still writes locally).

# Local CSVs, run folders, and chips (default: ../site-orchestrator-data)
# SITE_ORCHESTRATOR_DATA=C:\Users\Mmelendez\Codebases\site-orchestrator-data

# Queue filters (optional)
# STATES=WI,IL
# Stage__c picklist values (default Outreach - Verified). Unset LIMIT for the full match set.
# Non-hits stay in Salesforce unless held out; pair LIMIT with OFFSET or SKIP_FROM.
# STAGES=Outreach - Verified
# LIMIT=
# OFFSET=0
# SKIP_FROM=
# IDS=a0A...,a0A...
# Carrier_Leasing_Source__c LIKE needle (unset = no carrier filter). Example: NFL
# CARRIER_LIKE=
# Metro_Classification__c exact match (default Major NFL Metro). none / all = no metro filter.
# METRO_CLASSIFICATION=Major NFL Metro
# LLM_CLASSIFIED=0
# APPLY=1
# DEQUEUE_HOLDOUTS=1
# VERBOSE=1
# RUN_DIR=
# ENRICHMENT_DELAY_S=2

# FCC/TowerSource only (no Nearmap, NAIP, Gemini, or Claude).
# Unique hit ≤25 m, or pin on-structure ≤5 m, writes Site_Type + coords + LLM_Classified.
# Successful writes: LLM_Classified=true. Unique hits also get Site_Type.
# Misses stay blank type until a later flip. No LLM_Holdout on success.
# Apply errors retry once with LLM_Classified=false, LLM_Holdout=true.
# Misses stay in the queue — use LIMIT + SKIP_FROM (prior run folders or YYYY-MM-DD).
# DB_ONLY=1
# STAGES=New/Unreviewed,Enhanced/Unreviewed,Outreach,Outreach - Verified,Marketing
# OWNERS=none
# METRO_CLASSIFICATION=none
# LIMIT=200
# SKIP_FROM=
# APPLY=0

# NAIP rooftop confirm (already Site_Type=Rooftop). No Nearmap, no Claude.
# Building roof at the pin is enough — cellular antennas are not required.
# Rooftop label → persist type + LLM_Classified=true. Counts as rooftop SF write.
# Inconclusive → no Salesforce write.
# CONFIRM_ROOFTOP=1
# CARRIER_LIKE=ConnectX
# STAGES=New/Unreviewed,Enhanced/Unreviewed,Outreach,Outreach - Verified,Marketing,Working-Connected
# OWNERS=none
# METRO_CLASSIFICATION=none
# APPLY=0
# VERBOSE=1
